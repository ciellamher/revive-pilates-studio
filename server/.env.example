# Copy to .env and fill in. .env is git-ignored; this file is committed.
# On a deployed host, set these in the dashboard instead: there is no .env there.

# Local (page 4):    postgresql://postgres:your_password_here@localhost:5432/pilates
# Hosted (page 5):   postgresql://user:pass@host.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/pilates

# Signs the login links and sessions. REQUIRED on a live site: the server
# refuses to start without it there. Any long random string; generate one with:
#   openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string

# Who may open the admin dashboard. Comma-separated emails. They sign in with
# the same emailed link as everyone else.
ADMIN_EMAILS=you@example.com

# The Gmail account that sends login links, booking confirmations, class reminders and cancellation
# notices. The password is an APP PASSWORD (Google Account > Security >
# 2-Step Verification > App passwords), never the account's real password.
# Leave both empty on your laptop and mail goes to an Ethereal test inbox.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Whoever calls POST /api/reminders/send must present this. Any long random
# string; the same value goes in the GitHub repository secret CRON_SECRET.
CRON_SECRET=replace_with_another_long_random_string

# Comma-separated, no trailing slash, no path. The first one is also where the
# magic login link sends people, so put your live site first. An origin is scheme + host + port.
CORS_ORIGINS=http://localhost:5173

# Set to production on your host. Express and several libraries behave better,
# including not sending stack traces to your users.
NODE_ENV=development

# Do NOT set PORT locally or on the host. The host sets it for you.
