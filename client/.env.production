# Used by every production build (Vercel, GitHub Pages). This value ends up in
# the public JavaScript, which is fine: it is not a secret. Never put a key or
# password in a VITE_ variable. A variable of the same name set on the host
# overrides it, so leave it unset there.
VITE_API_BASE_URL=https://revive-pilates-studio.vercel.app
