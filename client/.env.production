# Used by every production build (Vercel, GitHub Pages). Both values end up in
# the public JavaScript, which is fine: they are not secrets. Never put a key or
# password in a VITE_ variable. A variable of the same name set on the host
# overrides these, so leave them unset there.
VITE_USE_MOCK_API=false
VITE_API_BASE_URL=https://revive-pilates-studio.vercel.app
